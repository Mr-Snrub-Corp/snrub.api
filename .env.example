POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
JWT_SECRET= 
JWT_ALGORITHM=
JWT_EXPIRES_MINUTES=
