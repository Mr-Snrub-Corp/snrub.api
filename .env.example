# MQTT / EMQX broker. Empty keys here; real values go in .env.development (gitignored).
# Compose sets MQTT_ROLE=api|simulator so each service picks the matching pair.
# Usernames must match emqx/acl.conf (defaults: snrub_api / snrub_sim).
# Host-run: MQTT_HOST=localhost and either MQTT_ROLE or MQTT_USERNAME/PASSWORD.
MQTT_HOST=
MQTT_PORT=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=
MQTT_ROLE=
MQTT_API_USERNAME=
MQTT_API_PASSWORD=
MQTT_SIM_USERNAME=
MQTT_SIM_PASSWORD=
EMQX_DASHBOARD_PASSWORD=

# Docker Compose profile: "vue" or "react" (controls which frontend starts)
# Set in .env file next to docker-compose.yaml
# COMPOSE_PROFILES=vue